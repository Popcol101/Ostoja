# --- Baza -------------------------------------------------------------------------------------
# Lokalnie: ./scripts/db-reset.sh. Supabase: Project Settings → Database → Connection string
# (Session pooler, port 5432, rola postgres). Tylko po stronie serwera – nigdy w zmiennych NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/ostoja

# --- Sesja ------------------------------------------------------------------------------------
# Min. 32 znaki, losowe: openssl rand -hex 32
SESSION_SECRET=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki
# Adres aplikacji (linki dla rodzin, SMS-y). Bez ukośnika na końcu.
APP_URL=http://localhost:3000

# --- Logowanie --------------------------------------------------------------------------------
# Konta testowe na stronie logowania. Na wersji testowej true, na produkcji false.
DEMO_MODE=true
# Logowanie linkiem z e-maila (Supabase Auth). Puste = formularz e-mail ukryty.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Powiadomienia ----------------------------------------------------------------------------
# Push: npx web-push generate-vapid-keys. Puste = przycisk „Włącz powiadomienia” niedostępny.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:opiekun@twoja-domena.pl
# SMS przez SMSAPI (token OAuth z panelu SMSAPI). Puste = tryb testowy: nic nie wychodzi.
SMSAPI_TOKEN=
# Pole nadawcy zarejestrowane w SMSAPI (np. nazwa zakładu); puste = numer domyślny
SMSAPI_SENDER=
# true = SMSAPI sprawdza wiadomość, ale jej nie wysyła (i nie pobiera opłaty)
SMSAPI_TEST=true
# Sekret harmonogramu wysyłki (/api/powiadomienia), min. 16 znaków: openssl rand -hex 24
CRON_SECRET=

# Numer opiekuna Ostoi 24/7 pokazywany rodzinom
NEXT_PUBLIC_OPIEKUN_PHONE=+48 000 000 000
